      <h2 className="text-2xl md:text-4xl font-bold text-white -mt-2 leading-tight">{children}</h2>
      <div className="mt-4 h-0.5 w-20 bg-gradient-to-r from-[#6F3FFF] to-[#7A8FFF]" />
    </div>
  );
}

function Badge({ children, accent = '#6F3FFF' }: { children: React.ReactNode; accent?: string }) {
  return (
    <span
      className="text-xs px-3 py-1 rounded-full border font-medium"
      style={{ borderColor: accent + '50', color: accent, background: accent + '12' }}
    >
      {children}
    </span>
  );
}

function ModalSection({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <div>
      <h4 className="text-[#8FA5FF] font-semibold mb-3 text-xs uppercase tracking-widest border-b border-[#6F3FFF]/20 pb-2 mb-3">
        {title}
      </h4>
      {children}
    </div>
  );
}

export default function PortfolioPage() {
