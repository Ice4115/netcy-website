function SectionLabel({ num, children }: { num: string; children: React.ReactNode }) {
  return (
    <div className="mb-12">
      <span className="text-4xl md:text-5xl font-mono font-black tracking-[0.15em] bg-gradient-to-r from-[#6F3FFF] to-[#7A8FFF] bg-clip-text text-transparent opacity-60 select-none">
        {num}
