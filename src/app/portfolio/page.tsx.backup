                  <GlareHover
                    width="100%" height="100%"
                    background="linear-gradient(145deg, #14093a 0%, #160e40 100%)"
                    borderColor="#4A2FFF" glareColor="#4A2FFF" glareOpacity={0.08} glareSize={350}
                  >
                    <div className="p-5 flex flex-col sm:flex-row sm:items-center gap-4">
                      <Search size={24} className="text-[#4A2FFF] flex-shrink-0" loop={true} loopDelay={2000} />
                      <div className="flex-1">
                        <div className="flex items-center gap-2 mb-1">
                          <span className="text-xs font-mono tracking-widest uppercase text-[#4A2FFF]/90">Veille 2</span>
                          <span className="text-[10px] px-2 py-0.5 rounded-full border border-[#4A2FFF]/40 text-[#8FA5FF]/70 bg-[#4A2FFF]/10">En préparation</span>
                        </div>
                        <p className="text-gray-300 text-sm font-medium">Cybersécurité · Cloud Computing · DevOps</p>
                      </div>
                      <button onClick={() => setOpenModal('veille2')} className="text-xs font-semibold uppercase tracking-wider text-[#4A2FFF] hover:text-[#8FA5FF] transition flex-shrink-0">
