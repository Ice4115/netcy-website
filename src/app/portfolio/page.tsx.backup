                            { t: "Éthique de l'IA", d: "Enjeux sociétaux et cadre réglementaire autour de l'intelligence artificielle." },
                          ].map((item, j) => (
                            <div key={j} className="flex gap-3 p-3 rounded-lg bg-[#8FA5FF]/5 border border-[#8FA5FF]/10">
                              <span className="text-[#8FA5FF] mt-0.5 flex-shrink-0 text-xs">›</span>
                              <div>
                                <p className="text-white text-sm font-semibold">{item.t}</p>
                                <p className="text-gray-300 text-sm mt-0.5 leading-relaxed">{item.d}</p>
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                      <div className="mt-5 pt-5 border-t border-[#8FA5FF]/10 flex justify-end">
