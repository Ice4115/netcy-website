            {/* ─── VEILLE ─── */}
            <section id="veille" className="py-16 scroll-mt-14">
              <AnimatedContent distance={30} duration={0.6}>
                <SectionLabel num="05">Veille Technologique</SectionLabel>
              </AnimatedContent>
              {/* Veille 1 full-width avec sujets + Veille 2 petite bannière */}
              <div className="space-y-4">
                <AnimatedContent distance={40} duration={0.6} className="w-full">
                  <GlareHover
                    width="100%" height="100%"
                    background="linear-gradient(145deg, #14093a 0%, #1a1040 100%)"
                    borderColor="#8FA5FF" glareColor="#8FA5FF" glareOpacity={0.15} glareSize={450}
                  >
                    <div className="p-7 md:p-8">
                      <div className="flex flex-col md:flex-row md:items-start gap-6">
                        <div className="flex-shrink-0 md:w-56">
                          <Bot size={32} className="text-[#8FA5FF] mb-3" loop={true} loopDelay={2000} />
                          <span className="text-xs font-mono tracking-widest uppercase text-[#8FA5FF]/80">Veille 1 · 2024-2025</span>
