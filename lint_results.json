veille1' | 'veille2' | 'e5projet1' | 'e5projet2' | null;\n\nconst NAV_SECTIONS = [\n  { href: '#cv', label: 'CV' },\n  { href: '#frise', label: 'Frise' },\n  { href: '#options', label: 'Options' },\n  { href: '#stages', label: 'Stages' },\n  { href: '#veille', label: 'Veille' },\n  { href: '#e5', label: 'Projets E5' },\n  { href: '#competences', label: 'Compétences' },\n  { href: '#contact', label: 'Contact' },\n];\n\nconst COMPETENCE_ROWS = [\n  { name: 'Projet Infrastructure système réseaux', period: ['31/03/2025', 'au', '18/04/2025'], comps: [true, false, false, false, false, false] },\n  { name: 'Installation de postes', period: [], comps: [false, false, false, false, false, false] },\n  { name: 'Couverture wifi', period: [], comps: [false, true, false, false, true, false] },\n  { name: 'Workshop | C, compte rendu, vidéo', period: ['09/09/2024', 'au', '13/09/2024'], comps: [false, false, false, true, false, false] },\n  { name: 'Bataille navale (Algo et PHP)', period: ['08/10/2024', 'au', '04/11/2024'], comps: [false, false, false, false, false, false] },\n  { name: \"Création d'une base de données pour un site de location de gîtes\", period: ['15/10/2024', 'au', '26/11/2024'], comps: [false, false, false, true, false, false] },\n  { name: 'Open Innovation (scanner de carte à jouer)', period: ['19/11/2024', 'au', '2025'], comps: [false, false, false, true, false, false] },\n  { name: 'Projet solution web', period: ['26/11/2024', 'au', '09/01/2025'], comps: [true, false, false, true, true, true] },\n  { name: 'Projet communication digitale', period: ['28/11/2024', 'au', '30/01/2025'], comps: [false, false, true, true, false, false] },\n  { name: 'Projet Application Objet', period: ['06/02/2025', 'au', '06/03/2025'], comps: [false, false, false, true, false, false] },\n];\n\nconst COMPETENCE_HEADERS = [\n  'Gérer le patrimoine informatique',\n  'Répondre aux incidents',\n  'Développer la présence en ligne',\n  'Travailler en mode projet',\n  'Mettre à disposition un service informatique',\n  'Organiser son développement pro',\n];\n\nfunction SectionLabel({ num, children }: { num: string; children: React.ReactNode }) {\n  return (\n    <div className=\"mb-12\">\n      <span className=\"text-4xl md:text-5xl font-mono font-black tracking-[0.15em] bg-gradient-to-r from-slate-400 to-slate-200 bg-clip-text text-transparent opacity-60 select-none\">\n        {num}\n      </span>\n      <h2 className=\"text-2xl md:text-4xl font-bold text-white -mt-2 leading-tight\">{children}</h2>\n      <div className=\"mt-4 h-0.5 w-20 bg-gradient-to-r from-indigo-500 to-indigo-400\" />\n    </div>\n  );\n}\n\nfunction Badge({ children, accent = '#6366f1' }: { children: React.ReactNode; accent?: string }) {\n  return (\n    <span\n      className=\"text-xs px-3 py-1 rounded-full border font-medium\"\n      style={{ borderColor: accent + '50', color: accent, background: accent + '12' }}\n    >\n      {children}\n    </span>\n  );\n}\n\nfunction ModalSection({ title, children }: { title: string; children: React.ReactNode }) {\n  return (\n    <div>\n      <h4 className=\"text-indigo-300 font-semibold mb-3 text-xs uppercase tracking-widest border-b border-indigo-500/20 pb-2 mb-3\">\n        {title}\n      </h4>\n      {children}\n    </div>\n  );\n}\n\nexport default function PortfolioPage() {\n  const router = useRouter();\n  const [openModal, setOpenModal] = useState<ModalKey>(null);\n  const [cvVisible, setCvVisible] = useState(false);\n  const [privacyAccepted, setPrivacyAccepted] = useState(false);\n  const ROLES = [\"Étudiant BTS SIO — SISR\", \"Technicien Réseaux\", \"Développeur Web\", \"Cybersécurité\"];\n  const [roleIndex, setRoleIndex] = useState(0);\n  const [roleVisible, setRoleVisible] = useState(true);\n  useEffect(() => {\n    const t = setInterval(() => {\n      setRoleVisible(false);\n      setTimeout(() => {\n        setRoleIndex(i => (i + 1) % ROLES.length);\n        setRoleVisible(true);\n      }, 350);\n    }, 3200);\n    return () => clearInterval(t);\n  }, []);\n\n  const handleDownloadCV = () => {\n    const photoUrl = window.location.origin + '/images/profile.png';\n    const htmlContent = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>CV - Jung Jean-Marie</title>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }\n    body { font-family: 'Segoe UI', Arial, sans-serif; background: white; }\n    .cv { width: 210mm; min-height: 297mm; margin: 0 auto; display: flex; flex-direction: column; }\n    .header {\n      display: flex; align-items: center; gap: 28px;\n      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);\n      padding: 28px 36px;\n    }\n    .photo-ring {\n      width: 112px; height: 112px; border-radius: 50%;\n      border: 3px solid #6F3FFF; padding: 3px; flex-shrink: 0;\n    }\n    .photo { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: center 20%; display: block; }\n    .header-content { flex: 1; }\n    .header-name { font-size: 33px; font-weight: 800; color: white; letter-spacing: 4px; text-transform: uppercase; margin-bottom: 4px; }\n    .header-sub { font-size: 12px; color: #a5b4fc; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; }\n    .header-badge { display: inline-block; background: #6F3FFF; color: white; font-size: 11.5px; font-weight: 700; padding: 5px 14px; border-radius: 20px; letter-spacing: 0.5px; margin-bottom: 12px; }\n    .body { display: flex; flex: 1; }\n    .left-col { width: 34%; background: #f1f5f9; padding: 26px 20px; display: flex; flex-direction: column; }\n    .right-col { width: 66%; background: white; padding: 22px 24px; border-left: 1px solid #e2e8f0; }\n    .section { margin-bottom: 24px; }\n    .sec-title { font-size: 10.5px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: #6F3FFF; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }\n    .sec-title::after { content: ''; flex: 1; height: 1px; background: #cbd5e1; }\n    .contact-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }\n    .c-icon { width: 16px; flex-shrink: 0; text-align: center; color: #6F3FFF; font-size: 13px; margin-top: 2px; }\n    .c-text { font-size: 12px; color: #334155; line-height: 1.5; word-break: break-all; }\n    .edu-item { margin-bottom: 16px; }\n    .edu-degree { font-size: 13px; font-weight: 700; color: #0f172a; }\n    .edu-school { font-size: 11.5px; color: #64748b; margin-top: 3px; }\n    .edu-year { display: inline-block; font-size: 10.5px; color: #6F3FFF; background: #ede9fe; padding: 2px 9px; border-radius: 10px; margin-top: 5px; font-weight: 600; }\n    .skills-wrap { display: flex; flex-wrap: wrap; gap: 6px; }\n    .skill-tag { font-size: 11.5px; background: #1e293b; color: white; padding: 4px 10px; border-radius: 4px; font-weight: 500; }\n    .soft-tag { font-size: 11.5px; background: #ede9fe; color: #5b21b6; padding: 4px 10px; border-radius: 4px; font-weight: 600; }\n    .profile-text { font-size: 12px; color: #475569; line-height: 1.8; }\n    .tl-item { position: relative; padding-left: 22px; margin-bottom: 14px; }\n    .tl-item::before { content: ''; position: absolute; left: 5px; top: 16px; width: 1px; height: calc(100% + 2px); background: #e2e8f0; }\n    .tl-item:last-child::before { display: none; }\n    .tl-dot { position: absolute; left: 0; top: 4px; width: 11px; height: 11px; border-radius: 50%; background: #6F3FFF; border: 2px solid white; box-shadow: 0 0 0 2px #6F3FFF; }\n    .tl-dot.stage { background: #0ea5e9; box-shadow: 0 0 0 2px #0ea5e9; }\n    .exp-title { font-size: 13px; font-weight: 700; color: #0f172a; }\n    .exp-badge { display: inline-block; font-size: 9.5px; font-weight: 700; background: #0ea5e9; color: white; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle; letter-spacing: 0.5px; }\n    .exp-co { font-size: 11px; color: #6F3FFF; font-weight: 600; margin: 2px 0; text-transform: uppercase; letter-spacing: 0.5px; }\n    .exp-date { font-size: 10.5px; color: #94a3b8; margin-bottom: 3px; }\n    .exp-desc { font-size: 11.5px; color: #64748b; line-height: 1.5; }\n    .proj-item { margin-bottom: 12px; padding-left: 10px; border-left: 2px solid #6F3FFF; }\n    .proj-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 2px; }\n    .proj-sub { font-size: 11.5px; font-weight: 600; color: #6F3FFF; margin-bottom: 2px; }\n    .proj-desc { font-size: 11.5px; color: #64748b; line-height: 1.5; }\n    @media print {\n      @page { margin: 0; size: A4 portrait; }\n      body { margin: 0; }\n      .cv { width: 100%; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"cv\">\n    <div class=\"header\">\n      <div class=\"photo-ring\">\n        <img class=\"photo\" src=\"${photoUrl}\" alt=\"Jung Jean-Marie\" />\n      </div>\n      <div class=\"header-content\">\n        <div class=\"header-name\">Jung Jean-Marie</div>\n        <div class=\"header-sub\">BTS SIO &middot; Option SISR &middot; 23 ans</div>\n        <div class=\"header-badge\">En recherche d&apos;une alternance &mdash; BTS SIO SISR</div>\n      </div>\n    </div>\n    <div class=\"body\">\n      <div class=\"left-col\">\n        <div class=\"section\">\n          <div class=\"sec-title\">Contact</div>\n          <div class=\"contact-row\"><i class=\"c-icon fa-solid fa-location-dot\"></i><div class=\"c-text\">3 Rue des Soldats, 34000 Montpellier</div></div>\n          <div class=\"contact-row\"><i class=\"c-icon fa-solid fa-envelope\"></i><div class=\"c-text\">jeanmarie.jung.pro@gmail.com</div></div>\n          <div class=\"contact-row\"><i class=\"c-icon fa-solid fa-phone\"></i><div class=\"c-text\">07 49 64 44 78</div></div>\n          <div class=\"contact-row\"><i class=\"c-icon fa-solid fa-globe\"></i><div class=\"c-text\">netcy.fr</div></div>\n          <div class=\"contact-row\"><i class=\"c-icon fa-brands fa-linkedin-in\"></i><div class=\"c-text\">linkedin.com/in/jean-marie-jung-40683b218</div></div>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Formation</div>\n          <div class=\"edu-item\">\n            <div class=\"edu-degree\">BTS SIO &ndash; SISR</div>\n            <div class=\"edu-school\">EPSI Montpellier</div>\n            <div class=\"edu-year\">2024 &ndash; 2026 (en cours)</div>\n          </div>\n          <div class=\"edu-item\">\n            <div class=\"edu-degree\">Baccalaur&eacute;at G&eacute;n&eacute;ral S</div>\n            <div class=\"edu-school\">Lyc&eacute;e Polyvalent Philippe de Girard</div>\n            <div class=\"edu-year\">2017 &ndash; 2021</div>\n          </div>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Comp&eacute;tences</div>\n          <div class=\"skills-wrap\">\n            <div class=\"skill-tag\">PHP</div>\n            <div class=\"skill-tag\">SQL</div>\n            <div class=\"skill-tag\">HTML / CSS / JS</div>\n            <div class=\"skill-tag\">Python</div>\n            <div class=\"skill-tag\">C++</div>\n            <div class=\"skill-tag\">Next.js / React</div>\n            <div class=\"skill-tag\">R&eacute;seaux &amp; Infra</div>\n            <div class=\"skill-tag\">Cyburs&eacute;curit&eacute;</div>\n            <div class=\"skill-tag\">Microsoft Office</div>\n            <div class=\"skill-tag\">Sage</div>\n          </div>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Soft Skills</div>\n          <div class=\"skills-wrap\">\n            <div class=\"soft-tag\">Autonomie</div>\n            <div class=\"soft-tag\">Travail en &eacute;quipe</div>\n            <div class=\"soft-tag\">Polyvalence</div>\n            <div class=\"soft-tag\">Responsable</div>\n            <div class=\"soft-tag\">Entrepreneuriat</div>\n          </div>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Centres d&apos;int&eacute;r&ecirc;t</div>\n          <div class=\"skills-wrap\">\n            <div class=\"soft-tag\">Arts martiaux</div>\n            <div class=\"soft-tag\">D&eacute;veloppement</div>\n            <div class=\"soft-tag\">Infrastructure</div>\n            <div class=\"soft-tag\">Jeux vid&eacute;o</div>\n          </div>\n        </div>\n      </div>\n      <div class=\"right-col\">\n        <div class=\"section\">\n          <div class=\"sec-title\">Profil</div>\n          <p class=\"profile-text\">\n            Pratiquant le Viet Vo Dao depuis 9 ans, j&apos;ai d&eacute;velopp&eacute; rigueur, discipline et esprit d&apos;&eacute;quipe. &Eacute;tudiant en deuxi&egrave;me ann&eacute;e &agrave; l&apos;EPSI en BTS SIO option SISR et major de ma promotion, j&apos;ai choisi cette fili&egrave;re par passion pour la programmation et les technologies. Orient&eacute; vers les r&eacute;seaux et la cybers&eacute;curit&eacute;, je m&apos;int&eacute;resse particuli&egrave;rement au fonctionnement des syst&egrave;mes et &agrave; la circulation s&eacute;curis&eacute;e des donn&eacute;es.<br><br>\n            Mon objectif professionnel est de devenir administrateur r&eacute;seau, tout en continuant &agrave; d&eacute;velopper mes comp&eacute;tences en d&eacute;veloppement web, car je ne souhaite pas d&eacute;laisser ma passion pour le code. J&apos;ai d&apos;ailleurs cr&eacute;&eacute; ma micro-entreprise NETCY, sp&eacute;cialis&eacute;e en cr&eacute;ation de sites web s&eacute;curis&eacute;s. Je suis actuellement &agrave; la recherche d&apos;une alternance pour mon BTS SIO SISR, afin de mettre en pratique les comp&eacute;tences acquises au cours de ma formation.\n          </p>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Exp&eacute;riences Professionnelles</div>\n          <div class=\"timeline\">\n            <div class=\"tl-item\">\n              <div class=\"tl-dot stage\"></div>\n              <div class=\"exp-title\">Stage &ndash; Technicien Informatique <span class=\"exp-badge\">STAGE</span></div>\n              <div class=\"exp-co\">Devensys Cybers&eacute;curit&eacute; &middot; Montpellier</div>\n              <div class=\"exp-date\">19 janvier 2026 &ndash; 20 f&eacute;vrier 2026</div>\n              <div class=\"exp-desc\">D&eacute;ploiement de PC en interne, journ&eacute;es d&eacute;couverte dans les diff&eacute;rents services de l&apos;entreprise, mise en place d&apos;un serveur PKI.</div>\n            </div>\n            <div class=\"tl-item\">\n              <div class=\"tl-dot stage\"></div>\n              <div class=\"exp-title\">Stage &ndash; Technicien Informatique <span class=\"exp-badge\">STAGE</span></div>\n              <div class=\"exp-co\">Infoboost &middot; Mauguio</div>\n              <div class=\"exp-date\">23 avril 2025 &ndash; 4 juillet 2025</div>\n              <div class=\"exp-desc\">Reconditionnement de PC, pr\\u00e9sentation infog&eacute;rance.</div>\n            </div>\n            <div class=\"tl-item\">\n              <div class=\"tl-dot\"></div>\n              <div class=\"exp-title\">Vendeur &ndash; Polyvalent</div>\n              <div class=\"exp-co\">Boulangerie Paul &middot; Saint-R&eacute;my-de-Provence</div>\n              <div class=\"exp-date\">Sept. 2023 &ndash; Juin 2024 &middot; CDI</div>\n              <div class=\"exp-desc\">Mise en place de la marchandise, vente, encaissement et entretien de la boutique.</div>\n            </div>\n            <div class=\"tl-item\">\n              <div class=\"tl-dot\"></div>\n              <div class=\"exp-title\">Vendeur</div>\n              <div class=\"exp-co\">Boulangerie Caract&egrave;res de Pain &middot; Ch&acirc;teaurenard</div>\n              <div class=\"exp-date\">2022 &ndash; 2023 &middot; 2 CDD</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"section\">\n          <div class=\"sec-title\">Projets R&eacute;alis&eacute;s</div>\n          <div class=\"proj-item\">\n            <div class=\"proj-title\">NETCY &ndash; Micro-entreprise</div>\n            <div class=\"proj-sub\">Cr&eacute;ation de sites web s&eacute;curis&eacute;s</div>\n            <div class=\"proj-desc\">Conception et d&eacute;veloppement de mon site vitrine NETCY (Next.js, React, TypeScript), sp&eacute;cialis&eacute; en cr&eacute;ation de sites web s&eacute;curis&eacute;s et cybers&eacute;curit&eacute; r&eacute;seau pour les professionnels. Gestion compl&egrave;te : d&eacute;veloppement full-stack, s&eacute;curisation, SEO et h&eacute;bergement.</div>\n          </div>\n          <div class=\"proj-item\">\n            <div class=\"proj-title\">Cr&eacute;ation d&apos;un site web &ndash; H&ocirc;tel Neptune</div>\n            <div class=\"proj-desc\">Partie administrateur, s&eacute;curisation du site, gestion des r&eacute;servations et des paiements.</div>\n          </div>\n          <div class=\"proj-item\">\n            <div class=\"proj-title\">Cr&eacute;ation d&apos;un site web &ndash; E-Commerce</div>\n            <div class=\"proj-sub\">Le Seigneur des Goodies</div>\n            <div class=\"proj-desc\">Partie administrateur, s&eacute;curisation du site, gestion des produits et des paiements.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <script>window.onload = function() { window.print(); }</script>\n</body>\n</html>`;\n    const printWindow = window.open('', '_blank');\n    if (!printWindow) {\n      alert('Veuillez autoriser les popups pour télécharger le CV');\n      return;\n    }\n    printWindow.document.write(htmlContent);\n    printWindow.document.close();\n  };\n\n  return (\n    <>\n      <div className=\"w-full text-white overflow-x-hidden relative min-h-screen\">\n        <div className=\"fixed inset-0 w-full h-full z-0\">\n          <LiquidEther\n            colors={['#0f172a', '#1e1b4b', '#312e81', '#1e293b']}\n            mouseForce={20}\n            cursorSize={100}\n            autoDemo={true}\n            autoSpeed={0.4}\n            autoIntensity={1.8}\n            autoResumeDelay={1000}\n            resolution={0.5}\n          />\n        </div>\n\n        <div className=\"relative z-10\">\n\n          {/* ─── STICKY NAV ─── */}\n          <div className=\"sticky top-0 z-40 backdrop-blur-sm\">\n            <div className=\"max-w-6xl mx-auto px-4 h-14 flex items-center gap-3\">\n              <Link\n                href=\"/\"\n                className=\"inline-flex items-center gap-1.5 text-slate-400 hover:text-white transition text-xs font-semibold flex-shrink-0\"\n              >\n                ← Accueil\n              </Link>\n              <div className=\"flex-1 flex justify-center overflow-hidden\">\n                <PillNav\n                  logo=\"/images/logo_tab.png\"\n                  logoAlt=\"NETCY\"\n                  items={NAV_SECTIONS.map((s) => ({ href: s.href, label: s.label }))}\n                  baseColor=\"rgba(9, 9, 11, 0.55)\"\n                  pillColor=\"rgba(24, 24, 27, 0.8)\"\n                  pillTextColor=\"#a1a1aa\"\n                  hoveredPillTextColor=\"#ffffff\"\n                  initialLoadAnimation={false}\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* ─── HERO ─── */}\n          <section className=\"pt-20 pb-16 px-4 text-center\">\n            <div className=\"max-w-4xl mx-auto\">\n              <AnimatedContent distance={20} duration={0.6}>\n                <p className=\"text-xs tracking-[0.4em] uppercase font-semibold text-indigo-400 mb-5\">\n                  Portfolio BTS SIO\n                </p>\n              </AnimatedContent>\n              <AnimatedContent